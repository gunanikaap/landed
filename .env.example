# Copy this file to .env and fill in your values.  ->  cp .env.example .env

# Which LLM backend to use: "anthropic" or "bedrock"
LANDED_LLM_PROVIDER=anthropic

# ---- Option A: Anthropic API (fastest to set up) ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
LANDED_LLM_MODEL=claude-sonnet-4-6

# ---- Option B: AWS Bedrock (best CV story; uncomment to use) ----
# LANDED_LLM_PROVIDER=bedrock
# AWS_REGION=eu-west-1
# LANDED_LLM_MODEL=<a Claude model id your Bedrock account can access>
# (AWS credentials come from your normal aws configure / env vars)
