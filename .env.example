# Copy this file to .env and fill in ONE provider.  ->  cp .env.example .env

# ============ OPTION 1 (FREE, recommended): Google Gemini ============
# Free key, no credit card: https://aistudio.google.com -> Get API key
LANDED_LLM_PROVIDER=gemini
GEMINI_API_KEY=your-free-key-here
# LANDED_LLM_MODEL=gemini-2.5-flash        # default; override if needed

# ============ OPTION 2 (FREE backup): Groq ============
# Free key: https://console.groq.com
# LANDED_LLM_PROVIDER=groq
# GROQ_API_KEY=your-free-key-here
# LANDED_LLM_MODEL=openai/gpt-oss-120b      # recommended: reliable OpenAI-format tool calls
# Avoid llama-3.3-70b-versatile on Groq: it leaks Llama <function=...> tool syntax and 400s.

# ============ OPTION 3 (paid): Anthropic API ============
# LANDED_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# LANDED_LLM_MODEL=claude-sonnet-4-6

# ============ OPTION 4 (paid via AWS): Bedrock ============
# LANDED_LLM_PROVIDER=bedrock
# AWS_REGION=eu-west-1
# LANDED_LLM_MODEL=<a Claude model id your Bedrock account can access>
